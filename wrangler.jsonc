{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coc-cwl",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coc-cwl-signup",
      "database_id": "12ede25a-30ff-45d6-8c62-80f2958aec07"
    }
  ],
  // 每 6 小时检查一次容量：使用率超过 50% 时从最旧记录开始清理（3 个月内不动）。
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
